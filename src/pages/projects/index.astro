---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'proyectos', text: 'Proyectos' },
]
---

<PageLayout title='Proyectos' {headings} view>
  <p>Actividad en Github:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/fabian-martinez-rincon'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    En este apartado se encuentran todos los proyectos relevantes que fui programando a lo largo de mi vida como desarrollador 😀. 
    Todos los dias trato de mejorar y seguir aprendiendo, si necesitas una mano o me queres consultar para algun trabajo no dudes en contactarme.
  </p>
  <h2 id='proyectos'>Proyectos</h2>
  <ProjectSection
    projects={[
      {
        name: 'ETL Pluto TV',
        description: 'Pipeline asincrono que extrae el catalogo completo de una plataforma OTT, con logging estructurado y manejo de reintentos. Selenium, aiohttp, asyncio y BeautifulSoup.',
        image: 'pluto_tv.jpg',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/Scraping_PLUTO_TV' }]
      },
      {
        name: 'Lab-Genetics',
        description: 'Sistema de gestion de muestras biologicas con trazabilidad de resultados y control de acceso por rol. Flask, SQLAlchemy y PostgreSQL.',
        image: 'lab-genetics.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/Lab-Genetics' }]
      },
      {
        name: 'ACL Manager',
        description: 'Gestion de permisos (ACL) sobre Linux con interfaz propia: reemplaza la administracion manual de comandos a partir de un Excel. Python, Pandas, Tkinter y Bash.',
        image: 'acl.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/acl-manager' }]
      },
      {
        name: 'Emuti',
        description: 'Automatizacion de carga de datos de certificacion en maquinas de juego: de 60 a 5 horas de pruebas, 0% de error. Pandas, PyAutoGUI, PyGetWindow y OpenPyXL.',
        image: 'emuti.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/EmuTi' }]
      },
      {
        name: 'Hope Trade',
        description: 'Plataforma web de donaciones e intercambio de productos con roles, sesiones y formularios seguros. Flask, SQLAlchemy, PostgreSQL y Flask-Bcrypt.',
        image: 'hopetrade.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/Ingenieria-de-Software2' }]
      },
      {
        name: 'Chart IT',
        description: 'Aplicacion web para generar y compartir graficos a partir de datos cargados por el usuario. Flask y JavaScript.',
        image: 'charit.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/Char-IT' }]
      },
      {
        name: 'MidFlash',
        description: 'Automatizacion del renderizado de imagenes por lote.',
        image: 'midflash.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/MidFlash' }]
      },
      {
        name: 'SQL Modify',
        description: 'Automatizacion de recorte y escalado de imagenes en lote.',
        image: 'sqlmodify.png',
        links: [{ type: 'github', href: 'https://github.com/Fabian-Martinez-Rincon/modify-SQL' }]
      }
    ]}
  />

</PageLayout>

