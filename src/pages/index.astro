---
import { Image } from 'astro:assets'

import { Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import avatar from '@/assets/yo.png'
import config from '@/site-config'
import ToolSection from '@/components/about/ToolSection.astro'
import AwardCard from '@/components/home/AwardCard.astro'

import { ProjectCardHorizontal, HighlightText, HighlightImageCard, SkillBadges, Card } from '../../packages/pure/components/pages'

// Mismo orden y contenido que el CV
const competencias = [
  { name: 'Lenguajes', skills: ['Python', 'SQL', 'Bash', 'JavaScript', 'HTML/CSS'] },
  { name: 'Datos', skills: ['Polars', 'Pandas', 'ETL', 'PostgreSQL', 'MongoDB', 'Modelado analítico', 'Calidad y gobernanza de datos'] },
  { name: 'Cloud e infra', skills: ['AWS', 'S3', 'Linux', 'Git', 'Docker'] },
  { name: 'Extracción', skills: ['APIs REST', 'Playwright', 'Selenium', 'BeautifulSoup', 'asyncio', 'aiohttp', 'Regex'] },
  { name: 'Análisis', skills: ['Jupyter', 'IPyWidgets', 'OpenPyXL', 'Definición de KPIs', 'Reporting'] },
  { name: 'Idiomas', skills: ['Español (nativo)', 'Inglés (técnico)'] }
]
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#151718'>
  <main class='flex w-full flex-col items-center'>

    <section class="animate mb-10 flex flex-col items-center gap-y-7" id="content-header">
      <div class="flex flex-col items-center gap-y-4">
        <h1
          class="text-3xl font-bold relative after:content-[''] after:block after:h-[3px] after:bg-[#EBBFA7] after:mx-auto after:mt-2"
        >
          {config.author}
        </h1>
        <p class="text-lg text-center">Data Engineer · Data Quality & Analytics</p>
        <p class="text-sm text-muted-foreground text-center">La Plata, Buenos Aires, Argentina</p>
        <div class='flex flex-col items-center gap-y-4'>
          <div class="flex flex-wrap justify-center gap-x-7 gap-y-3">

            <Label
              title="Curriculum"
              as="a"
              href="/fabianmartinezrincon.pdf"
              target="_blank"
              color="emerald"
            >
              <Icon name="document" class="size-5" slot="icon" />
            </Label>

            <Label
              title="LinkedIn"
              as="a"
              href="https://www.linkedin.com/in/fabian-martinez-rincon/"
              target="_blank"
              color="orange"
            >
              <Icon name="link" class="size-5" slot="icon" />
            </Label>

            <Label
              title="Github"
              as="a"
              href="https://github.com/Fabian-Martinez-Rincon"
              target="_blank"
              color="blue"
            >
              <Icon name="github" class="size-5" slot="icon" />
            </Label>

            <Label
              title="Email"
              as="a"
              href="mailto:fabianmartinezrincon.123@gmail.com"
              color="zinc"
            >
              <Icon name="email" class="size-5" slot="icon" />
            </Label>

          </div>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title=''>
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6">

          <Image
            src={avatar}
            alt='Fabian Martinez Rincon'
            class='h-40 w-auto rounded-xl border p-1 md:order-2'
            loading='eager'
          />

          <div class="flex-1 flex flex-col gap-4 md:order-1">
            <p class="text-muted-foreground">
              Data Engineer con más de 3 años construyendo
              <span class="text-yellow-800 dark:text-yellow-300">pipelines ETL</span> y sistemas de
              <span class="text-yellow-800 dark:text-yellow-300">control de calidad de datos</span>
              sobre grandes volúmenes.
            </p>
            <p class="text-muted-foreground">
              Diseñé el framework de validación que hoy usan
              <span class="text-yellow-800 dark:text-yellow-300">13 Data Engineers</span> de forma autónoma,
              estandarizando los criterios de calidad sobre
              <span class="text-yellow-800 dark:text-yellow-300">158 plataformas</span> y evitando más de
              <span class="text-yellow-800 dark:text-yellow-300">1.180 horas</span> de trabajo manual por ciclo de análisis.
            </p>
            <p class="text-muted-foreground">
              Trabajo cruzando el área técnica y la de negocio: traduzco desvíos y anomalías de datos en métricas accionables.
              Stack principal:
              <span class="text-yellow-800 dark:text-yellow-300">Python</span>,
              <span class="text-yellow-800 dark:text-yellow-300">Polars</span>,
              <span class="text-yellow-800 dark:text-yellow-300">SQL</span>,
              <span class="text-yellow-800 dark:text-yellow-300">MongoDB</span> y
              <span class="text-yellow-800 dark:text-yellow-300">AWS</span>.
            </p>
          </div>

        </div>
      </Section>

      <Section title='Experiencia Profesional'>
        <Card
          heading="BB Media (Fabric Data Company)"
          subheading="Data Engineer · Metadata de más de 150 plataformas OTT para clientes de toda la región"
          date="Sep. 2024 — Actualidad"
          logo="/src/assets/experiencia/fabric.jpg"
        >
          <HighlightImageCard
            imagePath="/src/assets/polars.svg"
            highlights={[
              "Escala: reduje el tiempo de análisis de 8 horas a 30 minutos por plataforma (↓94%). 158 plataformas procesadas en ~79 horas, evitando más de 1.180 horas de trabajo manual.",
              "Impacto transversal: eliminé la dependencia del equipo de análisis. 13 Data Engineers validan hoy la calidad de forma autónoma, sin abrir tasks externas y sin frenar el ciclo de desarrollo."
            ]}
          />
          <HighlightText
            text="Gobernanza: diseñé un sistema unificado de controles de calidad que estandarizó los criterios de validación de todo el equipo, reemplazando revisiones ad-hoc por reglas versionadas y reutilizables."
            color="#FF3A83"
          />
          <HighlightText
            text="Cliente: reduje errores y retrabajos reportados por clientes al detectar anomalías antes de la entrega."
            color="#FF3A83"
          />
          <HighlightText
            text="Pipelines: desarrollo y mantenimiento de ETL en Python y Polars sobre MongoDB y AWS, con scrapers (Playwright, BeautifulSoup) y consumo de APIs de múltiples plataformas OTT."
            color="#FF3A83"
          />
          <HighlightText
            text="Reporting: métricas de cobertura y calidad por plataforma en notebooks interactivos (Jupyter e IPyWidgets) que el equipo consume para priorizar correcciones."
            color="#FF3A83"
          />
          <SkillBadges
            skills={[
              'Python','Polars','Pandas','SQL','MongoDB','AWS','S3','Playwright','BeautifulSoup',
              'APIs REST','Regex','Jupyter','IPyWidgets','Git','Linux','ETL'
            ]}
          />
        </Card>

        <Card
          heading="Gaming Labs Sudamérica"
          subheading="Backend Developer · Laboratorio de certificación de máquinas de juego, entorno regulado y auditado"
          date="Jul. 2023 — Sep. 2024"
          logo="/src/assets/experiencia/gli.jpg"
        >
          <HighlightText
            text="Automaticé la carga de datos de certificación en máquinas de juego, reduciendo el ciclo de pruebas de 60 a 5 horas con 0% de margen de error (Pandas, PyAutoGUI, PyGetWindow, OpenPyXL, Tkinter)."
            color="#3375C0"
          />
          <HighlightText
            text="Construí un comparador de bases de datos con Difflib que detecta diferencias entre entornos y emite un reporte de modificaciones en Excel (Xlsxwriter): de 5 horas a minutos."
            color="#3375C0"
          />
          <HighlightText
            text="Desarrollé una herramienta de gestión de permisos (ACL) sobre Linux con interfaz propia, reemplazando la administración manual en toda la infraestructura empresarial. Automaticé la asignación con Bash."
            color="#3375C0"
          />
          <HighlightText
            text="Automaticé la extracción de elementos HTML a Excel con BeautifulSoup para el equipo de QA, mejorando la precisión y la velocidad de captura de datos."
            color="#3375C0"
          />
          <SkillBadges
            skills={[
              'Python','Pandas','OpenPyXL','Difflib','Xlsxwriter','Tkinter','PyAutoGUI','PyGetWindow','Bash','Linux','ACL'
            ]}
          />
        </Card>
      </Section>

      <Section title='Proyectos'>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <ProjectCardHorizontal
          imagePath="/src/assets/projects/pluto_tv.jpg"
          heading="ETL Pluto TV"
          description="Pipeline asíncrono de extracción del catálogo completo de una plataforma OTT, con logging estructurado y manejo de reintentos."
          skills={["Python","Selenium","aiohttp","asyncio","BeautifulSoup"]}
          hrefCode="https://github.com/Fabian-Martinez-Rincon/Scraping_PLUTO_TV"
        />

        <ProjectCardHorizontal
          imagePath="/src/assets/projects/lab-genetics.png"
          heading="Lab-Genetics"
          description="Sistema de gestión de muestras biológicas con trazabilidad de resultados, control de acceso por rol, pagos y recorridos con Google Maps."
          skills={["Python","Flask","SQLAlchemy","PostgreSQL","Authlib"]}
          hrefCode="https://github.com/Fabian-Martinez-Rincon/TTPS-Opcion-E"
          hrefBlog="/blog/lab_genetics"
        />

        <ProjectCardHorizontal
          imagePath="/src/assets/projects/acl.png"
          heading="ACL Manager"
          description="Gestión de permisos (ACL) en Linux con interfaz propia. Reemplaza la administración manual de comandos en toda la infraestructura."
          skills={["Python","Pandas","Tkinter","Linux","Bash"]}
          hrefCode="https://github.com/Fabian-Martinez-Rincon/acl-manager"
          hrefBlog="/blog/acl_manager"
        />

        <ProjectCardHorizontal
          imagePath="/src/assets/projects/emuti.png"
          heading="Emuti"
          description="Automatización de carga de datos de certificación en máquinas de juego: de 60 a 5 horas de pruebas, 0% de error."
          skills={["Python","Pandas","PyGetWindow","OpenPyXL","PyAutoGUI","Tkinter"]}
          hrefCode="https://github.com/Fabian-Martinez-Rincon/EmuTi"
          hrefBlog="/blog/emuti"
        />
        </div>
        <p class="text-sm text-muted-foreground">
          Más proyectos en <a href="/projects" class="underline">Proyectos</a>.
        </p>
      </Section>

      <Section title='Reconocimientos y Voluntariados'>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <AwardCard
            tag="Premio"
            heading="Ganador UNIDEA 2023"
            org="UNICEN, Tandil"
            year="2023"
            text="Líder del proyecto ganador entre estudiantes y graduados de distintas universidades del país."
            imagePath="/src/assets/yo/unidea/1.jpeg"
            href="/about#unidea"
          />
          <AwardCard
            tag="Distinción"
            heading="Reconocimiento del Presidente de la UNLP"
            org="Universidad Nacional de La Plata"
            year="2023"
            text="Distinción por actuación destacada representando a la Universidad."
            imagePath="/src/assets/yo/nota/1.jpg"
            href="/about#nota"
          />
          <AwardCard
            tag="Charla"
            heading="Disertante en Hackatón «Soluciones por la Inclusión»"
            org="UNLP, Facultad de Informática"
            year="2023"
            text="Charla sobre accesibilidad y tecnología ante estudiantes y equipos participantes."
            imagePath="/src/assets/yo/hackaton_de_accecibilidad.jpg"
            href="/about#charlas"
          />
          <AwardCard
            tag="Voluntariado"
            heading="Tutor de acompañamiento"
            org="UNLP, Facultad de Informática"
            text="Mentoría a estudiantes ingresantes durante un ciclo lectivo completo."
          />
        </div>
      </Section>

      <Section title='Educación'>
        <Card
          heading="Universidad Nacional de La Plata — Facultad de Informática"
          subheading="Analista Programador Universitario · Graduado"
          date="2021 — 2025"
          logo="/src/assets/experiencia/unlp.jpg"
        >
          <HighlightText
            text="Bases de datos relacionales, PostgreSQL y SQL, patrones de diseño, metodologías ágiles (Scrum), Linux, Bash scripting y Python."
            color="#CA383D"
          />
        </Card>
        <Card
          heading="EEPT N.° 6 Albert Thomas"
          subheading="Técnico en Electrónica"
          date="2014 — 2020"
          logo="/src/assets/experiencia/thomas.jpg"
        >
          <HighlightText
            text="Orientación en sistemas embebidos, C++ y proyectos con Arduino."
            color="#3375C0"
          />
        </Card>
      </Section>

      <Section title='Competencias Técnicas'>
        <div class="flex flex-col gap-3">
          {competencias.map(({ name, skills }) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
              <span class="w-32 shrink-0 text-sm font-semibold">{name}</span>
              <SkillBadges skills={skills} />
            </div>
          ))}
        </div>
      </Section>

      <ToolSection
        class='mb-5'
        title='Herramientas'
        tools={[
          { name: 'Python', icon: import('@/assets/tools/python.svg?raw') },
          { name: 'Polars', icon: import('@/assets/tools/polars.svg?raw') },
          { name: 'Pandas', icon: import('@/assets/tools/pandas.svg?raw') },
          { name: 'MongoDB', icon: import('@/assets/tools/mongodb.svg?raw') },
          { name: 'PostgreSQL', icon: import('@/assets/tools/PostgresSQL.svg?raw') },
          { name: 'Playwright', icon: import('@/assets/tools/Playwrite.svg?raw') },
          { name: 'Selenium', icon: import('@/assets/tools/Selenium.svg?raw') },
          { name: 'Flask', icon: import('@/assets/tools/flask.svg?raw') },
          { name: 'Linux', icon: import('@/assets/tools/linux.svg?raw') },
          { name: 'Bash', icon: import('@/assets/tools/Bash.svg?raw') },
          { name: 'Git', icon: import('@/assets/tools/Git.svg?raw') },
          { name: 'GitHub', icon: import('@/assets/tools/GitHub.svg?raw') },
          { name: 'JavaScript', icon: import('@/assets/tools/JavaScript.svg?raw') },
          { name: 'HTML', icon: import('@/assets/tools/html.svg?raw') },
          { name: 'CSS', icon: import('@/assets/tools/css.svg?raw') }
        ]}
      />
    </div>
  </main>
</PageLayout>
